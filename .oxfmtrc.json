{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": {
    "groups": [
      "side_effect",
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "type"
    ],
    "newlinesBetween": true
  },
  "ignorePatterns": [
    "backend/**",
    "docs/**",
    "data/**",
    "dist/**",
    "node_modules/**",
    ".claude/**",
    ".idea/**",
    "*.md"
  ]
}
