# --- Secrets & local env ---
.env
.env.*
!.env.example

# --- Runtime data (Docker volume: ./data:/data) ---
/data/

# --- Go ---
/backend/server
/backend/bin/
*.exe
*.test
*.out
coverage.out
coverage.html
vendor/

# Embedded frontend build output — generated by `npm run build`, consumed by go:embed.
# The directory itself is kept so a fresh clone still compiles.
/backend/internal/web/dist/*
!/backend/internal/web/dist/.gitkeep

# --- Node / Vite ---
node_modules/
# Anchored, not a bare `dist/`: a bare rule would exclude the directory
# backend/internal/web/dist and make the .gitkeep negation above unreachable.
/dist/
/frontend/dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tooling caches ---
.oxlintcache
*.tsbuildinfo

# --- Editors ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
