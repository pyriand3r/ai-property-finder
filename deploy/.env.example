# Copy to .env next to docker-compose.yml on the Docker host and fill in.

# Required. Only used on first start of the pgdata volume to initialise the
# DB user — changing it later requires changing the password inside Postgres too.
DB_PASSWORD=change-me

# Required — the app's own login password (Frontend + API, see
# docs/adr/0018). Its SHA-256 digest also signs session JWTs.
APP_PASSWORD=change-me

# Required for the Agent. Written into the app_config table on first boot;
# after that the DB value is authoritative and this variable is ignored.
CLAUDE_API_KEY=

# Optional. Session cookie Secure flag (default true) — leave at the
# default here; this deployment path always sits behind the external
# TLS-terminating reverse proxy described in this file.
# COOKIE_SECURE=true

# Optional. Host port the web UI is published on (default 8080).
# PF_HTTP_PORT=8080

# Optional. Image tag to run (default latest). build-image.sh also tags each
# image with its git revision, e.g. PF_IMAGE_TAG=3f2a9c1 to pin/roll back.
# PF_IMAGE_TAG=latest
