# Copy to .env and fill in. docker-compose.yml reads these.

# Required.
DB_PASSWORD=change-me

# Required — the app's own login password (Frontend + API, see
# docs/adr/0018). Its SHA-256 digest also signs session JWTs, so pick
# something with real entropy.
APP_PASSWORD=change-me

# Optional. Defaults to true (the container sits behind an external
# TLS-terminating reverse proxy in every documented deployment). Set to
# false only for local development without a proxy in front — e.g.
# `npm run dev`'s Vite dev server proxies straight to
# http://localhost:8080 in plain HTTP, and a Secure cookie would be
# silently discarded by the browser, looping the login back to /login.
# COOKIE_SECURE=false

# Required from Layer 6 onward (Claude Agent). Not read by anything in
# Layer 0-5 yet, but docker-compose.yml already passes it through.
CLAUDE_API_KEY=
