{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "import", "vue"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "eqeqeq": ["error", "smart"],
    "typescript/no-explicit-any": "warn",
    "typescript/consistent-type-imports": "error",
    "import/no-cycle": "error",
    "unicorn/filename-case": "off",
    "unicorn/no-null": "off"
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.test.ts", "**/*.spec.vue"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off"
      }
    }
  ],
  "ignorePatterns": ["backend/**", "docs/**", "data/**", "dist/**", "node_modules/**", "*.d.ts"]
}
